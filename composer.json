{
    "name": "emitwave/laravel",
    "description": "EmitWave broadcasting driver for Laravel.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/emitwave/emitwave-laravel",
    "keywords": [
        "emitwave",
        "laravel",
        "broadcasting",
        "realtime",
        "websocket"
    ],
    "authors": [
        {
            "name": "EmitWave"
        }
    ],
    "support": {
        "issues": "https://github.com/emitwave/emitwave-laravel/issues",
        "source": "https://github.com/emitwave/emitwave-laravel"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "emitwave/php": "^0.1",
        "illuminate/broadcasting": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Emitwave\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emitwave\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emitwave\\Laravel\\EmitwaveServiceProvider"
            ]
        }
    }
}
